{
  "name": "aster-design-system",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "Aster Design System — One source of truth for humans and AI agents",
  "type": "module",
  "main": "./dist/js/aster.js",
  "module": "./dist/js/aster.js",
  "types": "./dist/js/aster.d.ts",
  "style": "./dist/css/aster.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphaac0der/Aster-DS.git"
  },
  "homepage": "https://github.com/alphaac0der/Aster-DS#readme",
  "bugs": {
    "url": "https://github.com/alphaac0der/Aster-DS/issues"
  },
  "keywords": [
    "design-system",
    "tokens",
    "css-custom-properties",
    "components",
    "vanilla-js",
    "ai-agents",
    "zero-dependency",
    "wcag-aa"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/aster.d.ts",
      "import": "./dist/js/aster.js",
      "default": "./dist/js/aster.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./components.css": "./dist/css/components.css",
    "./aster.css": "./dist/css/aster.css",
    "./css/tokens": "./dist/css/tokens.css",
    "./css/components": "./dist/css/components.css",
    "./css/aster": "./dist/css/aster.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/components.css": "./dist/css/components.css",
    "./css/aster.css": "./dist/css/aster.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/",
    "skills/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build:tokens": "node build-tools/build-tokens.js",
    "build:components": "node build-tools/build-components.js",
    "build:playground": "node build-tools/build-playground.js",
    "build": "npm run build:tokens && npm run build:components && npm run build:playground && npm run export:figma",
    "test:contrast": "node build-tools/verify-contrast.js",
    "test:docs": "node build-tools/verify-docs-consistency.js",
    "export:figma": "node build-tools/export-figma-tokens.js",
    "test:figma": "node build-tools/validate-figma-tokens.js",
    "test:components": "node build-tools/verify-component-contracts.js",
    "test:exports": "node build-tools/verify-package-exports.js",
    "test:browser": "node build-tools/audit-browser.js",
    "test:pack": "npm pack --dry-run",
    "test:isolated-build": "node build-tools/verify-isolated-build.js",
    "test": "npm run test:figma && npm run test:contrast && npm run test:components && npm run test:docs && npm run test:exports && npm run test:pack && npm run test:isolated-build",
    "playground": "node build-tools/serve-playground.js"
  },
  "devDependencies": {
    "style-dictionary": "^5.6.1"
  }
}
