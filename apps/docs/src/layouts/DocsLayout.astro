---
interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname
} = Astro.props;

import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<BaseLayout title={title} description={description} currentPath={currentPath} kind="docs">
  <div class="docs-shell">
    <!-- Canonical Documentation Sidebar -->
    <Sidebar currentPath={currentPath} />

    <!-- Main Content Area -->
    <main class="docs-main" id="main-content">
      <slot />
    </main>

    <aside class="toc" id="toc" aria-label="On this page" style="display:none;"></aside>
  </div>
</BaseLayout>
