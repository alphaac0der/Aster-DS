---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  kind?: 'landing' | 'docs' | 'playground';
  currentPath?: string;
}

const {
  title = "Aster Design System — One source of truth for humans and AI agents",
  description = "A token-first, zero-dependency design system designed to provide one authoritative source of truth with dual human and agent interfaces.",
  image = "/assets/brand/og-image.png",
  kind = "docs",
  currentPath = Astro.url.pathname
} = Astro.props;

import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:url" content="https://aster-ds.vercel.app/" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/brand/asterds-logo-white.svg" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/svg+xml" href="/assets/brand/aster-logo-black.svg" media="(prefers-color-scheme: light)" />

  <!-- Google Fonts: Bebas Neue, Manrope, Space Mono, Merriweather -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Phosphor Icons Web Font -->
  <link rel="stylesheet" type="text/css" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />

  <!-- Prevent Theme Flash -->
  <script is:inline>
    (function() {
      try {
        const stored = localStorage.getItem('aster-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <!-- Legacy Hash Route Redirect to Clean URLs -->
  <script is:inline>
    (function() {
      try {
        if (window.location.hash && window.location.hash.startsWith('#/')) {
          var target = window.location.hash.substring(2).split('?')[0].trim().toLowerCase();
          var componentRoutes = [
            'button', 'input', 'textarea', 'select', 'checkbox', 'radio', 'switch', 'slider',
            'table', 'badge', 'progress', 'skeleton', 'alert', 'tooltip', 'toast', 'dialog',
            'drawer', 'popover', 'dropdown', 'tabs', 'accordion'
          ];
          
          if (target === 'overview' || target === '' || target === 'home') {
            window.location.replace('/');
          } else if (target === 'playground') {
            window.location.replace('/playground');
          } else if (target === 'components') {
            window.location.replace('/components');
          } else if (target === 'introduction') {
            window.location.replace('/docs');
          } else if (target === 'tokens' || target === 'principles' || target === 'installation' || target === 'frameworks') {
            window.location.replace('/docs/' + target);
          } else if (componentRoutes.indexOf(target) !== -1) {
            window.location.replace('/components/' + target);
          }
        }
      } catch (e) {}
    })();
  </script>
</head>
<body data-kind={kind}>

