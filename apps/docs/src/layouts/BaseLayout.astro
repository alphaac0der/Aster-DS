          <path class="brand__logo-arc" d="M21 20H142C198 20.1667 354.5 53 354.5 198V361.5" stroke-width="40" stroke-linecap="round"/>
          <path class="brand__logo-arc" d="M65 110H137.564C171.147 110.1 265 129.81 265 216.852V315" stroke-width="40" stroke-linecap="round"/>
        </svg>
        <span>Aster</span>
        <span class="brand__ver">v0.0.1</span>
      </a>

      <nav class="top-nav" aria-label="Primary">
        <a href="/" class={currentPath === '/' ? 'active' : ''} data-nav-section="overview">Home</a>
        <a href="/docs" class={currentPath.startsWith('/docs') ? 'active' : ''} data-nav-section="docs">Docs</a>
        <a href="/components" class={currentPath.startsWith('/components') ? 'active' : ''} data-nav-section="components">Components</a>
        <a href="/playground" class={currentPath.startsWith('/playground') ? 'top-nav__playground active' : 'top-nav__playground'} data-nav-section="playground">Playground</a>
      </nav>

      <span class="header-spacer"></span>

      <button type="button" class="search-trigger" id="search-trigger" aria-label="Search documentation" aria-haspopup="dialog">
        <svg class="as-icon" aria-hidden="true"><use href="#i-search"/></svg>
        <span>Search docs...</span>
        <kbd>Ctrl K</kbd>
      </button>

      <button type="button" class="as-button as-button--ghost as-button--icon theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle color theme" title="Toggle color theme (Light / Dark)">
        <svg class="as-icon as-icon--sun" width="20" height="20" aria-hidden="true"><use href="#i-sun"/></svg>
        <svg class="as-icon as-icon--moon" width="20" height="20" aria-hidden="true"><use href="#i-moon"/></svg>
      </button>

      <a href="https://github.com/alphaac0der/Aster-DS" target="_blank" rel="noopener noreferrer" class="as-button as-button--ghost as-button--icon header-github-btn" id="header-github-btn" aria-label="Aster DS on GitHub" title="GitHub Repository">
        <svg class="as-icon" width="20" height="20" aria-hidden="true"><use href="#i-github"/></svg>
      </a>
    </div>
  </header>

  <div id="global-live-region" class="as-sr-only" role="status" aria-live="polite"></div>
  <div class="scrim" id="scrim"></div>

  <!-- Off-Canvas Sidebar Navigation (Available on all pages for mobile drawer) -->
  {kind !== 'docs' && <Sidebar currentPath={currentPath} />}

  <!-- Page Slot -->
  <slot />

  <!-- Command Palette Search Dialog Modal -->
  <dialog class="palette" id="palette" aria-label="Search documentation">
    <form method="dialog" id="palette-form" style="display:contents">
      <div class="palette__field">
        <svg class="as-icon" aria-hidden="true"><use href="#i-search"/></svg>
        <input id="palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" placeholder="Search pages, components, and sections..." autocomplete="off" aria-label="Search" />
        <kbd>Esc</kbd>
      </div>
      <ul class="palette__list" id="palette-list" role="listbox" aria-label="Results"></ul>
      <div class="palette__foot"><span>&uarr;&darr; navigate</span><span>Enter open</span><span>Esc close</span></div>
    </form>
  </dialog>

  <!-- Interactive Client Behavior Scripts -->
  <script>
    import { 
      initAsterComponents,
      setButtonLoading,
      validateInput
    } from '../../../../dist/js/aster.js';

    function initClient() {
      // 1. Initialize Aster component behaviors
      initAsterComponents(document);

      // 2. Deterministic Multi-Category Syntax Highlighter & Line Numbers
      const MASTER_TOKEN_RE = /(&lt;!--[\s\S]*?--&gt;|\/\*[\s\S]*?\*\/|\/\/[^\n]*|^\s*#[^\n]*)|(&lt;\/?[a-zA-Z][\w:-]*|\/?&gt;)|(\b[a-zA-Z_:][\w:.-]*(?=\s*=))|("[^"]*"|'[^']*'|`[^`]*`)|(\b(?:import|from|export|const|let|var|function|return|async|await|if|else|new|true|false|null|undefined|document|window)\b)|(--as-[\w-]+|\b(?:initAsterComponents|setButtonLoading|setFieldValidation|validateInput|computeSelectionState|syncTableOverflow|showToast|addEventListener|getElementById|querySelector)\b)|(\b\d+(?:\.\d+)?(?:px|rem|ms|s|%)?\b)/gm;

      const esc = (s: string) => String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      function highlightCode(rawText: string) {
        const escaped = esc(rawText);
        return escaped.replace(MASTER_TOKEN_RE, (match, com, tag, attr, str, kw, fn, num) => {
          if (com) return `<span class="tok-com">${com}</span>`;
          if (tag) return `<span class="tok-tag">${tag}</span>`;
          if (attr) return `<span class="tok-attr">${attr}</span>`;
          if (str) return `<span class="tok-str">${str}</span>`;
          if (kw) return `<span class="tok-kw">${kw}</span>`;
          if (fn) return `<span class="tok-fn">${fn}</span>`;
          if (num) return `<span class="tok-num">${num}</span>`;
          return match;
        });
      }

      function enhanceCodeBlocks(scope: HTMLElement | Document = document) {
        scope.querySelectorAll('.code-block').forEach((block) => {
          const codeEl = block.querySelector('code') as HTMLElement | null;
          if (!codeEl || codeEl.dataset.highlighted === 'true') return;
          const raw = (codeEl.textContent || '').trim();
          codeEl.dataset.raw = raw;
          codeEl.innerHTML = highlightCode(raw);
          codeEl.dataset.highlighted = 'true';

          const pre = codeEl.closest('pre');
          if (pre && !pre.parentElement?.classList.contains('code-editor-body')) {
            const linesCount = raw.split('\n').length;
            const wrapper = document.createElement('div');
            wrapper.className = 'code-editor-body';
            const gutter = document.createElement('div');
            gutter.className = 'code-gutter';
            gutter.setAttribute('aria-hidden', 'true');
            gutter.innerHTML = Array.from({ length: linesCount }, (_, i) => `<span>${i + 1}</span>`).join('');
            pre.parentNode?.insertBefore(wrapper, pre);
            wrapper.appendChild(gutter);
            wrapper.appendChild(pre);
          }
        });
      }
      enhanceCodeBlocks(document);

      // 3. Theme Toggle
      const themeBtn = document.getElementById('theme-toggle-btn');
      if (themeBtn) {
        themeBtn.onclick = () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('aster-theme', next); } catch (e) {}
        };
      }

      // 4. Mobile Navigation Drawer (Standard Aster body[data-nav-open])
      const menuBtn = document.getElementById('menu-btn');
      const scrim = document.getElementById('scrim');
      
      function openNav() {
        document.body.setAttribute('data-nav-open', '');
        menuBtn?.setAttribute('aria-expanded', 'true');
      }

      function closeNav() {
        document.body.removeAttribute('data-nav-open');
        menuBtn?.setAttribute('aria-expanded', 'false');
      }

      if (menuBtn) {
        menuBtn.onclick = (e) => {
          e.stopPropagation();
          if (document.body.hasAttribute('data-nav-open')) {
            closeNav();
          } else {
            openNav();
          }
        };
      }

      if (scrim) {
        scrim.onclick = closeNav;
      }

      // Close on navigation link click
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest('.nav-link') || target?.closest('.sidebar a')) {
          closeNav();
        }
      });

      // Close on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (document.body.hasAttribute('data-nav-open')) {
            closeNav();
          }
        }
      });

      // 5. Command Palette Search (Ctrl+K)
      const palette = document.getElementById('palette') as HTMLDialogElement | null;
      const searchTrigger = document.getElementById('search-trigger');
      const paletteInput = document.getElementById('palette-input') as HTMLInputElement | null;
      const paletteList = document.getElementById('palette-list');

      const searchablePages = [
        { title: 'Home', path: '/', category: 'Overview' },
        { title: 'Interactive Playground', path: '/playground', category: 'Playground' },
        { title: 'Introduction', path: '/docs', category: 'Getting Started' },
        { title: 'Installation & Setup', path: '/docs/installation', category: 'Getting Started' },
        { title: 'Core Principles', path: '/docs/principles', category: 'Foundations' },
        { title: 'Design Tokens', path: '/docs/tokens', category: 'Foundations' },
        { title: 'Framework Integration', path: '/docs/frameworks', category: 'Foundations' },
        { title: 'Button', path: '/components/button', category: 'Components' },
        { title: 'Input & Field', path: '/components/input', category: 'Components' },
        { title: 'Textarea', path: '/components/textarea', category: 'Components' },
        { title: 'Select', path: '/components/select', category: 'Components' },
        { title: 'Checkbox', path: '/components/checkbox', category: 'Components' },
        { title: 'Radio Group', path: '/components/radio', category: 'Components' },
        { title: 'Switch', path: '/components/switch', category: 'Components' },
        { title: 'Slider', path: '/components/slider', category: 'Components' },
        { title: 'Data Table', path: '/components/table', category: 'Components' },
        { title: 'Badge', path: '/components/badge', category: 'Components' },
        { title: 'Progress', path: '/components/progress', category: 'Components' },
        { title: 'Skeleton', path: '/components/skeleton', category: 'Components' },
        { title: 'Alert', path: '/components/alert', category: 'Components' },
        { title: 'Tooltip', path: '/components/tooltip', category: 'Components' },
        { title: 'Toast', path: '/components/toast', category: 'Components' },
        { title: 'Dialog', path: '/components/dialog', category: 'Components' },
        { title: 'Drawer', path: '/components/drawer', category: 'Components' },
        { title: 'Popover', path: '/components/popover', category: 'Components' },
        { title: 'Dropdown Menu', path: '/components/dropdown', category: 'Components' },
        { title: 'Tabs', path: '/components/tabs', category: 'Components' },
        { title: 'Accordion', path: '/components/accordion', category: 'Components' }
      ];

      function renderPalette(query = '') {
        if (!paletteList) return;
        const q = query.trim().toLowerCase();
        const matches = searchablePages.filter(p => p.title.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
        if (matches.length === 0) {
          paletteList.innerHTML = '<li class="palette__empty" role="presentation">No results found</li>';
          return;
        }
        paletteList.innerHTML = matches.map((m, i) => `
          <li role="option" aria-selected="${i === 0}">
            <a href="${m.path}" class="palette__link">
              <span class="palette__item-title">${m.title}</span>
              <span class="palette__item-category">${m.category}</span>
            </a>
          </li>
        `).join('');
      }

      if (palette && searchTrigger && paletteInput) {
        searchTrigger.onclick = () => {
          palette.showModal();
          renderPalette();
          paletteInput.value = '';
          paletteInput.focus();
        };

        paletteInput.oninput = (e: Event) => {
          renderPalette((e.target as HTMLInputElement).value);
        };

        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (palette.open) {
              palette.close();
            } else {
              palette.showModal();
              renderPalette();
              paletteInput.value = '';
              paletteInput.focus();
            }
          }
        });
      }

      // 6. Component 4-Tab Workbench Controller (Preview | Code | Prompt | Anatomy)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const tab = target?.closest('.preview-tab') as HTMLElement | null;
        if (!tab) return;
        const card = tab.closest('.preview-card');
        if (!card) return;
        const tabs = card.querySelectorAll('.preview-tab');
        const mode = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', String(active));
          (t as HTMLElement).tabIndex = active ? 0 : -1;
        });

        const canvas = card.querySelector('.preview-canvas') as HTMLElement | null;
        const code = card.querySelector('.preview-code') as HTMLElement | null;
        const prompt = card.querySelector('.preview-prompt') as HTMLElement | null;
        const anatomy = card.querySelector('.preview-anatomy') as HTMLElement | null;
        if (canvas) canvas.hidden = mode !== 'preview';
        if (code) {
          code.hidden = mode !== 'code';
          if (!code.hidden) enhanceCodeBlocks(code);
        }
        if (prompt) prompt.hidden = mode !== 'prompt';
        if (anatomy) anatomy.hidden = mode !== 'anatomy';
      });

      // Keyboard support for 4-tabs (ArrowLeft, ArrowRight, Home, End)
      document.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement | null;
        const tab = target?.closest('.preview-tab') as HTMLElement | null;
        if (!tab) return;
        const card = tab.closest('.preview-card');
        if (!card) return;
        const tabs = Array.from(card.querySelectorAll('.preview-tab')) as HTMLElement[];
        const idx = tabs.indexOf(tab);
        if (idx === -1) return;
        let nextTab: HTMLElement | null = null;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextTab = tabs[(idx + 1) % tabs.length];
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          nextTab = tabs[(idx - 1 + tabs.length) % tabs.length];
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextTab = tabs[0];
        } else if (e.key === 'End') {
          e.preventDefault();
          nextTab = tabs[tabs.length - 1];
        }
        if (nextTab) {
          nextTab.click();
          nextTab.focus();
        }
      });

      // 7. Copy Code and Copy Prompt Buttons (copies raw text, not highlighted HTML)
      document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement | null;
        const copyBtn = target?.closest('.copy-btn') as HTMLElement | null;
        if (copyBtn) {
          const block = copyBtn.closest('.code-block');
          const codeEl = (block?.querySelector('code') || block?.querySelector('pre')) as HTMLElement | null;
          if (codeEl) {
            try {
              const text = (codeEl.dataset.raw || codeEl.textContent || '').trim();
              await navigator.clipboard.writeText(text);
              const orig = copyBtn.textContent;
              copyBtn.textContent = 'Copied!';
              setTimeout(() => { copyBtn.textContent = orig; }, 1600);
            } catch (err) {}
          }
          return;
        }

        const copyPromptBtn = target?.closest('.copy-prompt-btn') as HTMLElement | null;
        if (copyPromptBtn) {
          const promptEl = copyPromptBtn.closest('.prompt-panel')?.querySelector('.prompt-panel__pre') as HTMLElement | null;
          if (promptEl) {
            try {
              await navigator.clipboard.writeText(promptEl.textContent || '');
              const orig = copyPromptBtn.textContent;
              copyPromptBtn.textContent = 'Copied Prompt!';
              setTimeout(() => { copyPromptBtn.textContent = orig; }, 1600);
            } catch (err) {}
          }
        }
      });

      // 8. Button Matrix Dynamic Generator
      (function buildButtonMatrix() {
        const matrixBody = document.querySelector('[data-matrix="button"] tbody');
        if (!matrixBody || matrixBody.children.length > 0) return;
        const BTN_VARIANTS = ['primary', 'secondary', 'destructive', 'ghost'];
        const BTN_STATES = [
          ['default', ''],
          ['hover', 'is-hover'],
          ['pressed', 'is-pressed'],
          ['focus', 'is-focus'],
          ['loading', ''],
          ['disabled', '']
        ];
        BTN_VARIANTS.forEach((v) => {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = v[0].toUpperCase() + v.slice(1);
          tr.appendChild(th);
          BTN_STATES.forEach(([state, cls]) => {
            const td = document.createElement('td');
            const b = document.createElement('button');
            b.type = 'button';
            b.className = `as-button as-button--${v} ${cls}`.trim();
            if (state === 'loading') {
              b.setAttribute('aria-busy', 'true');
              b.innerHTML = '<span class="as-spinner" aria-hidden="true"></span><span class="as-button__label">Saving</span>';
            } else {
              b.innerHTML = '<span class="as-button__label">Button</span>';
            }
            if (state === 'disabled') b.disabled = true;
            if (cls) b.tabIndex = -1;
            td.appendChild(b);
            tr.appendChild(td);
          });
          matrixBody.appendChild(tr);
        });
      })();

      // 9. Component Interactive Demos
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const sim = target?.closest('[data-sim-save]') as HTMLElement | null;
        if (sim) {
          if (sim.getAttribute('aria-busy') === 'true') return;
          const label = (sim.querySelector('.as-button__label') || sim) as HTMLElement;
          const orig = label.textContent || '';
          setButtonLoading(sim, true, 'Saving');
          setTimeout(() => {
            setButtonLoading(sim, false);
            label.textContent = orig;
          }, 1600);
        }
      });

      const ariaTarget = document.getElementById('aria-target');
      const ariaToggle = document.getElementById('aria-toggle');
      if (ariaTarget && ariaToggle) {
        ariaToggle.addEventListener('click', () => {
          const disabled = ariaTarget.getAttribute('aria-disabled') === 'true';
          const label = ariaTarget.querySelector('.as-button__label');
          const toggleLabel = ariaToggle.querySelector('.as-button__label') || ariaToggle;
          if (disabled) {
            ariaTarget.removeAttribute('aria-disabled');
            if (label) label.textContent = 'Publish';
            toggleLabel.textContent = 'Disable it';
          } else {
            ariaTarget.setAttribute('aria-disabled', 'true');
            if (label) label.textContent = 'Focus-retaining disabled';
            toggleLabel.textContent = 'Enable it';
          }
        });
      }

      const setWs = (v: string) => {
        const input = document.getElementById('in-ws') as HTMLInputElement | null;
        if (!input) return;
        input.value = v;
        validateInput(input);
      };
      document.getElementById('fill-invalid')?.addEventListener('click', () => setWs('Acme Platform!'));
      document.getElementById('fill-valid')?.addEventListener('click', () => setWs('acme-platform'));

      // 10. Interactive Slider Live Progress Update
      document.addEventListener('input', (e) => {
        const target = e.target as HTMLElement | null;
        const slider = target?.closest('.as-slider') as HTMLInputElement | null;
        if (!slider) return;
        slider.style.setProperty('--_progress', `${slider.value}%`);
        const valEl = document.getElementById('home-card-slider-val');
        if (valEl && slider.id === 'home-card-slider') {
          valEl.textContent = `${slider.value}%`;
        }
      });
      document.querySelectorAll('.as-slider').forEach((s) => {
        const slider = s as HTMLInputElement;
        slider.style.setProperty('--_progress', `${slider.value}%`);
      });

      // 11. Interactive Home Cards
      const homeBtn = document.getElementById('home-card-btn');
      if (homeBtn) {
        homeBtn.onclick = () => {
          const label = homeBtn.querySelector('.as-button__label');
          if (label) {
            const orig = label.textContent;
            label.textContent = 'Active!';
            homeBtn.style.transform = 'scale(0.95)';
            setTimeout(() => {
              homeBtn.style.transform = '';
              label.textContent = orig;
            }, 800);
          }
        };
      }

      const homeProgField = document.getElementById('home-card-progress-field');
      const homeProgBar = document.getElementById('home-card-progress-bar');
      const homeProgVal = document.getElementById('home-card-progress-val');
      const homeProg = document.getElementById('home-card-progress');
      const progSteps = [25, 48, 68, 85, 100];
      let progIdx = 2;
      if (homeProgField && homeProgBar && homeProgVal) {
        homeProgField.onclick = () => {
          progIdx = (progIdx + 1) % progSteps.length;
          const nextVal = progSteps[progIdx];
          homeProgBar.style.width = `${nextVal}%`;
          homeProgVal.textContent = `${nextVal}%`;
          if (homeProg) homeProg.setAttribute('aria-valuenow', String(nextVal));
        };
      }

      const bHealthy = document.getElementById('home-badge-healthy');
      const bSync = document.getElementById('home-badge-sync');
      if (bHealthy) {
        bHealthy.onclick = () => {
          bHealthy.classList.toggle('as-badge--success');
          bHealthy.classList.toggle('as-badge--neutral');
        };
      }
      if (bSync) {
        bSync.onclick = () => {
          bSync.classList.toggle('as-badge--warning');
          bSync.classList.toggle('as-badge--info');
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initClient);
    } else {
      initClient();
    }
  </script>
</body>
</html>
