  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- Canonical Aster DS Header -->
  <header class="site-header" role="banner">
    <div class="site-header__inner">
      <button type="button" class="as-button as-button--ghost as-button--icon menu-btn" id="menu-btn" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">
        <svg class="as-icon" width="20" height="20" aria-hidden="true"><use href="#i-menu"/></svg>
      </button>

      <a href="/" class="brand" aria-label="Aster, home">
