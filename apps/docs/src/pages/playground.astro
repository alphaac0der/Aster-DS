---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Interactive Playground — Aster Design System"
  description="One full-bleed stage for all 21 Aster components: change props live, measure real geometry, and copy the exact markup."
  kind="playground"
  currentPath="/playground"
>
  <div class="docs-shell">
    <main class="docs-main" id="main-content">
      <article class="doc-view" id="view-playground" data-active data-title="Interactive Playground" data-section="playground" data-kind="playground" aria-labelledby="t-playground">
        <h1 id="t-playground" class="as-sr-only" tabindex="-1">Interactive Playground</h1>
        <div id="pg-root"></div>
      </article>
    </main>
  </div>

  <script>
    import { mountStage } from '../../../../playground/scripts/stage.js';

    mountStage(document.getElementById('pg-root'), {
      docsHref: (slug) => `/components/${slug}`
    });
  </script>
</BaseLayout>
