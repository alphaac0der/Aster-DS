---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { componentsData } from '../../data/components.js';
import { guidance } from '../../data/guidance.js';

export const canonicalOrder = [
  'accordion',
  'alert',
  'avatar',
  'badge',
  'button',
  'card',
  'checkbox',
  'dialog',
  'drawer',
  'dropdown',
  'input',
  'link',
  'popover',
  'progress',
  'radio',
  'select',
  'skeleton',
  'slider',
  'switch',
  'table',
  'tabs',
  'textarea',
  'toast',
  'tooltip'
];

export async function getStaticPaths() {
  return canonicalOrder.map((slug, index) => {
    const prevSlug = index > 0 ? canonicalOrder[index - 1] : null;
    const nextSlug = index < canonicalOrder.length - 1 ? canonicalOrder[index + 1] : null;
    return {
      params: { slug },
      props: { 
        component: componentsData[slug],
        prevComponent: prevSlug ? componentsData[prevSlug] : null,
        nextComponent: nextSlug ? componentsData[nextSlug] : null
      }
    };
  });
}

const { slug } = Astro.params;
const { component, prevComponent, nextComponent } = Astro.props;
const guide = guidance[component.slug];
---

<DocsLayout 
  title={`${component.name} — Aster Design System`}
  description={guide.summary}
  currentPath={`/components/${slug}`}
>
  <article class="doc-view" id={`view-${component.slug}`} data-title={component.name} data-section="components" aria-labelledby={`t-${component.slug}`}>
    <!-- Component Page Header -->
    <header class="page-head">
      <div class="eyebrow">Components &middot; {component.category}</div>
      <h1 id={`t-${component.slug}`} tabindex="-1">{component.name}</h1>
      <p class="lead">{guide.summary}</p>
      
      <div class="component-meta">
        <span class="meta-tag meta-tag--success" title="Checked automatically with axe-core in light and dark themes on every CI run. Automated scans cover only part of WCAG.">Automated a11y scan passing</span>
        <span class="meta-tag meta-tag--accent" data-measured="height" hidden></span>
        <span class="meta-tag" data-measured="radius"></span>
        <span class="meta-tag">Element: {component.element}</span>
      </div>
    </header>

    <div class="doc-body">
      <!-- Primary 4-Tab Component Workbench: Preview | Code | Prompt | Anatomy -->
      <section class="doc-section">
        <h2>Component Workbench</h2>
        <p>Switch between the live interactive preview, syntax-highlighted implementation code, copyable AI coding agent prompt, and designer anatomy blueprint.</p>

        <div class="preview-card" id={`workbench-${component.slug}`}>
          <div class="preview-card__header">
            <span class="preview-card__title">{component.name} &middot; Canonical Spec</span>
            <div class="preview-tabs" role="tablist" aria-label={`${component.name} documentation tabs`}>
              <button type="button" class="preview-tab" role="tab" data-tab="preview" aria-selected="true" tabindex="0">Preview</button>
              <button type="button" class="preview-tab" role="tab" data-tab="code" aria-selected="false" tabindex="-1">Code</button>
              <button type="button" class="preview-tab" role="tab" data-tab="prompt" aria-selected="false" tabindex="-1">Prompt</button>
              <button type="button" class="preview-tab" role="tab" data-tab="anatomy" aria-selected="false" tabindex="-1">Anatomy</button>
            </div>
          </div>

          <!-- TAB 1: PREVIEW (Rendered directly into .preview-canvas without extra wrapper) -->
          <div class="preview-canvas" role="tabpanel" aria-label={`${component.name} live preview`}>
            <Fragment set:html={component.previewHtml} />
          </div>

          <!-- TAB 2: CODE (Deterministic Multi-Category Syntax Highlighting) -->
          <div class="preview-code" role="tabpanel" aria-label={`${component.name} implementation code`} hidden>
            <div class="code-block">
              <div class="code-block__bar">
                <div class="code-block__meta">
                  <span class="code-block__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span>HTML / ES Module &middot; components/{component.slug}/{component.slug}.css</span>
                </div>
                <button type="button" class="copy-btn">Copy Code</button>
              </div>
              <pre><code>{component.codeSnippet}</code></pre>
            </div>
          </div>

          <!-- TAB 3: PROMPT (AI Agent Implementation Prompt) -->
          <div class="preview-prompt" role="tabpanel" aria-label={`${component.name} AI agent prompt`} hidden>
            <div class="prompt-panel">
              <div class="prompt-panel__bar">
                <div>
                  <div class="prompt-panel__title">
                    <svg class="as-icon" width="15" height="15" aria-hidden="true"><use href="#i-star"/></svg> 
                    AI Agent Implementation Prompt &middot; {component.name}
                  </div>
                  <div class="prompt-panel__desc">Grounded in canonical tokens, geometry, ARIA contracts, and repository paths.</div>
                </div>
                <button type="button" class="copy-prompt-btn">Copy Prompt</button>
              </div>
              <pre class="prompt-panel__pre" data-measured="prompt">{component.promptSnippet}</pre>
            </div>
          </div>

          <!-- TAB 4: ANATOMY (real component, measured live) -->
          <div class="preview-anatomy" role="tabpanel" aria-label={`${component.name} visual anatomy and measurements`} hidden>
            <div data-anatomy={component.slug}></div>
          </div>
        </div>
      </section>

      <!-- Do and Don't -->
      <section class="doc-section">
        <h2>When to use it</h2>
        <div class="fd-rules">
          <div class="fd-rule"><h3>Do</h3><ul>{guide.do.map((t) => <li>{t}</li>)}</ul></div>
          <div class="fd-rule"><h3>Don't</h3><ul>{guide.dont.map((t) => <li>{t}</li>)}</ul></div>
        </div>
      </section>

      <!-- Variants and states, rendered from the real component -->
      <section class="doc-section" data-states-section hidden>
        <h2>Variants &amp; States</h2>
        <p>Every option, rendered live with real styles.</p>
        <div data-states={component.slug}></div>
      </section>

      <!-- Accessibility Specifications -->
      {component.a11yHtml && <Fragment set:html={component.a11yHtml} />}

      <!-- Canonical Token Bindings -->
      {component.tokensHtml && <Fragment set:html={component.tokensHtml} />}

      <!-- Sequential Component Pagination Footer -->
      <nav class="doc-pagination" aria-label="Documentation Pagination">
        {prevComponent ? (
          <a href={`/components/${prevComponent.slug}`} class="doc-pagination__link doc-pagination__link--prev" rel="prev">
            <span class="doc-pagination__dir">
              <svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow-left"/></svg> 
              Previous
            </span>
            <span class="doc-pagination__title">{prevComponent.name}</span>
          </a>
        ) : (
          <span class="doc-pagination__placeholder" aria-hidden="true"></span>
        )}

        {nextComponent ? (
          <a href={`/components/${nextComponent.slug}`} class="doc-pagination__link doc-pagination__link--next" rel="next">
            <span class="doc-pagination__dir">
              Next 
              <svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg>
            </span>
            <span class="doc-pagination__title">{nextComponent.name}</span>
          </a>
        ) : (
          <span class="doc-pagination__placeholder" aria-hidden="true"></span>
        )}
      </nav>
    </div>
  </article>

  <script>
    import { initAnatomy, applyMeasurements, renderStates } from '../../../../../playground/scripts/anatomy.js';
    import { initFoundations } from '../../../../../playground/scripts/foundations.js';

    initAnatomy();
    document.querySelectorAll('[data-states]').forEach(renderStates);
    initFoundations();
    const slug = document.querySelector('[data-anatomy]')?.getAttribute('data-anatomy');
    const measure = () => { if (slug) applyMeasurements(slug); };
    measure();
    document.fonts?.ready.then(measure);
    new MutationObserver(measure).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  </script>
</DocsLayout>
