---
import DocsLayout from '../../layouts/DocsLayout.astro';

const componentsList = [
  { slug: 'accordion', name: 'Accordion', desc: 'Vertically stacked expandable disclosure panels with keyboard navigation and smooth height expansion.' },
  { slug: 'alert', name: 'Alert', desc: 'Contextual notification banners with status semantic colors and Shade-DS red dot close button.' },
  { slug: 'badge', name: 'Badge', desc: 'Compact status pill indicators with semantic color variants and status dots.' },
  { slug: 'button', name: 'Button', desc: 'Interactive tactile button with Shade-DS cursor-origin circular hover spotlight and loading states.' },
  { slug: 'checkbox', name: 'Checkbox', desc: 'Accessible custom checkbox with indeterminate state and tactile focus ring.' },
  { slug: 'table', name: 'Data Table', desc: 'Accessible data table with sticky headers, sortable columns, and multi-row selection.' },
  { slug: 'dialog', name: 'Dialog', desc: 'Modal dialog overlay with backdrop blur, focus trap, Escape key handling, and macOS close dot.' },
  { slug: 'drawer', name: 'Drawer', desc: 'Sliding sheet from screen edges with focus trap and swipe/keyboard dismiss.' },
  { slug: 'dropdown', name: 'Dropdown Menu', desc: 'Action menu with items, dividers, and keyboard navigation.' },
  { slug: 'input', name: 'Input & Field', desc: 'Accessible text field with Shade-DS 44px control height, clear action button, and double 1px glass glow.' },
  { slug: 'popover', name: 'Popover', desc: 'Rich content popover positioned relative to anchor triggers.' },
  { slug: 'progress', name: 'Progress', desc: 'Determinate and indeterminate progress indicator bars.' },
  { slug: 'radio', name: 'Radio Group', desc: 'Accessible radio button group with keyboard arrow navigation.' },
  { slug: 'select', name: 'Select', desc: 'Custom dropdown select menu with keyboard search and accessible listbox semantics.' },
  { slug: 'skeleton', name: 'Skeleton', desc: 'Placeholder loading pulses for asynchronous content states.' },
  { slug: 'slider', name: 'Slider', desc: 'Numeric range slider with custom styled track and thumb.' },
  { slug: 'switch', name: 'Switch', desc: 'Toggle switch with smooth spring transition and accessible switch role.' },
  { slug: 'tabs', name: 'Tabs', desc: 'Accessible tabbed navigation interface with roving tabindex and smooth indicator transitions.' },
  { slug: 'textarea', name: 'Textarea', desc: 'Multi-line text input with character counter and auto-expanding height.' },
  { slug: 'toast', name: 'Toast', desc: 'Ephemeral notification toasts with queue management and auto-dismiss.' },
  { slug: 'tooltip', name: 'Tooltip', desc: 'Contextual micro-popover appearing on pointer hover or keyboard focus.' }
];
---

<DocsLayout 
  title="Components — Aster Design System"
  description="All 21 production components in the Aster Design System, built with zero dependencies and native CSS/JS."
  currentPath="/components"
>
  <article class="doc-view" id="view-components" data-title="Components" data-section="components" aria-labelledby="t-components">
    <!-- Component Directory Page Head -->
    <header class="page-head">
      <div class="eyebrow">Component Library &middot; 21 Components</div>
      <h1 id="t-components" tabindex="-1">Components</h1>
      <p class="lead">All 21 browser-native components. Engineered with single standard density, semantic tokens, and mathematical WCAG 2.2 AA contrast.</p>
    </header>

    <div class="doc-body">
      <!-- Component Cards Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-top: 24px;">
        {componentsList.map((c) => (
          <div class="home-comp-card" style="min-height: 140px; display: flex; flex-direction: column; justify-content: space-between;">
            <div style="padding: 16px;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <h3 style="margin: 0; font-size: 16px; font-weight: 600;">{c.name}</h3>
                <span class="as-badge as-badge--neutral" style="font-size: 11px;">2.2 AA</span>
              </div>
              <p style="margin: 0; font-size: 13px; line-height: 1.45; color: var(--doc-muted, #777777);">{c.desc}</p>
            </div>
            <div class="home-comp-card__footer">
              <a href={`/components/${c.slug}`} class="home-comp-card__name">Specs &rarr;</a>
              <a href={`/components/${c.slug}`} class="home-comp-card__arrow-btn" aria-label={`Go to ${c.name} component documentation`}>
                <svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </article>
</DocsLayout>
