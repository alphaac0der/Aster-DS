---
import DocsLayout from '../../layouts/DocsLayout.astro';

const semanticTokens = [
  { name: '--as-semantic-color-surface-canvas', light: '#FFFFFF', dark: '#121212', role: 'Primary background surface' },
  { name: '--as-semantic-color-surface-card', light: '#F5F5F5', dark: '#1E1E1E', role: 'Elevated container card surface' },
  { name: '--as-semantic-color-surface-subtle', light: '#EEEEEE', dark: '#282828', role: 'Subtle hover / secondary container' },
  { name: '--as-semantic-color-text-default', light: '#121212', dark: '#E0E0E0', role: 'High-contrast primary body text' },
  { name: '--as-semantic-color-text-muted', light: '#555555', dark: '#AAAAAA', role: 'Secondary / supporting description text' },
  { name: '--as-semantic-color-border-subtle', light: '#E0E0E0', dark: '#333333', role: 'Dividers and soft boundaries' },
  { name: '--as-semantic-color-border-strong', light: '#777777', dark: '#777777', role: 'Form control outlines (3:1 contrast)' },
  { name: '--as-semantic-color-border-focus', light: '#1565C0', dark: '#64B5F6', role: 'Focus ring indicator (3:1 contrast)' }
];

const densityTokens = [
  { name: '--as-density-control-height', value: '40px', role: 'Button standard height' },
  { name: '--as-density-control-height-comfortable', value: '44px', role: 'Form field / Input / Select height' },
  { name: '--as-density-control-padding-x', value: '24px', role: 'Button horizontal padding (--as-space-6)' },
  { name: '--as-density-control-padding-y', value: '8px', role: 'Button vertical padding' }
];

const radiusTokens = [
  { name: '--as-radius-sm', value: '4px', role: 'Inputs, selects, textareas, tags' },
  { name: '--as-radius-md', value: '8px', role: 'Alerts, popovers, small cards' },
  { name: '--as-radius-lg', value: '12px', role: 'Accordions, dialogs, drawers' },
  { name: '--as-radius-xl', value: '16px', role: 'Prominent floating modal containers' },
  { name: '--as-radius-full', value: '9999px', role: 'Pill buttons, badges, avatars' }
];
---

<DocsLayout 
  title="Design Tokens — Aster Design System"
  description="W3C DTCG-compliant design token catalog with strict semantic precedence and WCAG 2.2 AA contrast compliance."
  currentPath="/docs/tokens"
>
  <article class="doc-view" id="view-tokens" data-title="Design Tokens" data-section="docs" aria-labelledby="t-tokens">
    <header class="page-head">
      <div class="eyebrow">Foundations &middot; Tokens</div>
      <h1 id="t-tokens" tabindex="-1">Design Tokens</h1>
      <p class="lead">W3C DTCG-compliant design token catalog with mathematical WCAG 2.2 AA contrast compliance and single standard density.</p>
    </header>

    <div class="doc-body">
      <!-- Semantic Color Tokens Table -->
      <section class="doc-section">
        <h2>Semantic Color Tokens</h2>
        <p>Components bind strictly to semantic color tokens. Primitive colors exist solely as internal definitions.</p>
        <div style="overflow-x: auto; margin-top: 16px;">
          <table class="as-table" style="width: 100%;">
            <thead>
              <tr>
                <th scope="col">CSS Custom Property</th>
                <th scope="col">Light</th>
                <th scope="col">Dark</th>
                <th scope="col">Semantic Purpose</th>
              </tr>
            </thead>
            <tbody>
              {semanticTokens.map((t) => (
                <tr>
                  <td><code>{t.name}</code></td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <span style={`display: inline-block; width: 16px; height: 16px; border-radius: 4px; background: ${t.light}; border: 1px solid rgba(0,0,0,0.1);`}></span>
                      <code>{t.light}</code>
                    </div>
                  </td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <span style={`display: inline-block; width: 16px; height: 16px; border-radius: 4px; background: ${t.dark}; border: 1px solid rgba(255,255,255,0.2);`}></span>
                      <code>{t.dark}</code>
                    </div>
                  </td>
                  <td>{t.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Density & Sizing Tokens -->
      <section class="doc-section">
        <h2>Density Tokens (Single Standard Scale)</h2>
        <p>Aster DS adheres to a single standard density scale. Compact mode is not used.</p>
        <div style="overflow-x: auto; margin-top: 16px;">
          <table class="as-table" style="width: 100%;">
            <thead>
              <tr>
                <th scope="col">CSS Custom Property</th>
                <th scope="col">Value</th>
                <th scope="col">Control Ergonomics</th>
              </tr>
            </thead>
            <tbody>
              {densityTokens.map((t) => (
                <tr>
                  <td><code>{t.name}</code></td>
                  <td><code>{t.value}</code></td>
                  <td>{t.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Corner Radius Tokens -->
      <section class="doc-section">
        <h2>Corner Radius Tokens</h2>
        <p>Minimum corner radius is 4px. 2px radii are strictly prohibited.</p>
        <div style="overflow-x: auto; margin-top: 16px;">
          <table class="as-table" style="width: 100%;">
            <thead>
              <tr>
                <th scope="col">CSS Custom Property</th>
                <th scope="col">Radius</th>
                <th scope="col">Component Role</th>
              </tr>
            </thead>
            <tbody>
              {radiusTokens.map((t) => (
                <tr>
                  <td><code>{t.name}</code></td>
                  <td><code>{t.value}</code></td>
                  <td>{t.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Navigation footer -->
      <nav class="doc-pagination" aria-label="Documentation Pagination" style="margin-top: 48px;">
        <a href="/docs/principles" class="doc-pagination__link doc-pagination__link--prev" rel="prev">
          <span class="doc-pagination__dir"><svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow-left"/></svg> Previous</span>
          <span class="doc-pagination__title">&larr; Core Principles</span>
        </a>
        <a href="/docs/frameworks" class="doc-pagination__link doc-pagination__link--next" rel="next">
          <span class="doc-pagination__dir">Next <svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          <span class="doc-pagination__title">Framework Integration &rarr;</span>
        </a>
      </nav>
    </div>
  </article>
</DocsLayout>
