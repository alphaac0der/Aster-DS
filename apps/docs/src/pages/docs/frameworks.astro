---
import DocsLayout from '../../layouts/DocsLayout.astro';

const reactSnippet = `import 'aster-ds/aster.css';
import { useEffect } from 'react';
import { initAsterComponents } from 'aster-ds';

export function Button({ children, variant = 'primary' }) {
  useEffect(() => {
    initAsterComponents(document);
  }, []);

  return (
    <button className={\`as-button as-button--\${variant}\`}>
      <span className="as-button__label">{children}</span>
    </button>
  );
}`;

const vueSnippet = `<script setup>
import { onMounted } from 'vue';
import { initAsterComponents } from 'aster-ds';
import 'aster-ds/aster.css';

onMounted(() => {
  initAsterComponents(document);
});
</script>

<template>
  <button class="as-button as-button--primary">
    <span class="as-button__label"><slot /></span>
  </button>
</template>`;

const svelteSnippet = `<script>
  import { onMount } from 'svelte';
  import { initAsterComponents } from 'aster-ds';
  import 'aster-ds/aster.css';

  onMount(() => {
    initAsterComponents(document);
  });
</script>

<button class="as-button as-button--primary">
  <span class="as-button__label"><slot /></span>
</button>`;
---

<DocsLayout 
  title="Framework Integration — Aster Design System"
  description="How to integrate Aster DS in React, Next.js, Vue, Svelte, and Astro."
  currentPath="/docs/frameworks"
>
  <article class="doc-view" id="view-frameworks" data-title="Framework Integration" data-section="docs" aria-labelledby="t-frameworks">
    <header class="page-head">
      <div class="eyebrow">Foundations &middot; Integration</div>
      <h1 id="t-frameworks" tabindex="-1">Framework Integration</h1>
      <p class="lead">Zero runtime dependencies. Consume Aster DS seamlessly across React, Next.js, Vue, Svelte, and Astro using standard CSS and idempotent ES modules.</p>
    </header>

    <div class="doc-body">
      <!-- Philosophy -->
      <section class="doc-section">
        <h2>Zero Framework Lock-in</h2>
        <p>Aster delivers native web components and standard CSS custom properties. You do not need framework-specific wrappers to use Aster DS in any modern framework.</p>
      </section>

      <!-- React & Next.js -->
      <section class="doc-section">
        <h2>React &amp; Next.js (App Router / Pages)</h2>
        <p>Import Aster CSS globally and call <code>initAsterComponents</code> inside a <code>useEffect</code> or client component:</p>
        <div class="code-block" style="margin-bottom: 24px;">
          <div class="code-block__bar">
            <div class="code-block__meta"><span>React Component (Button.jsx)</span></div>
            <button type="button" class="copy-btn">Copy Code</button>
          </div>
          <pre><code>{reactSnippet}</code></pre>
        </div>
      </section>

      <!-- Vue 3 -->
      <section class="doc-section">
        <h2>Vue 3</h2>
        <p>Initialize components inside <code>onMounted</code> hook:</p>
        <div class="code-block" style="margin-bottom: 24px;">
          <div class="code-block__bar">
            <div class="code-block__meta"><span>Vue Component (Button.vue)</span></div>
            <button type="button" class="copy-btn">Copy Code</button>
          </div>
          <pre><code>{vueSnippet}</code></pre>
        </div>
      </section>

      <!-- Svelte -->
      <section class="doc-section">
        <h2>Svelte / SvelteKit</h2>
        <p>Use Aster classes directly with <code>onMount</code> initialization:</p>
        <div class="code-block" style="margin-bottom: 24px;">
          <div class="code-block__bar">
            <div class="code-block__meta"><span>Svelte Component (Button.svelte)</span></div>
            <button type="button" class="copy-btn">Copy Code</button>
          </div>
          <pre><code>{svelteSnippet}</code></pre>
        </div>
      </section>

      <!-- Navigation footer -->
      <nav class="doc-pagination" aria-label="Documentation Pagination" style="margin-top: 48px;">
        <a href="/docs/tokens" class="doc-pagination__link doc-pagination__link--prev" rel="prev">
          <span class="doc-pagination__dir"><svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow-left"/></svg> Previous</span>
          <span class="doc-pagination__title">&larr; Design Tokens</span>
        </a>
        <a href="/components" class="doc-pagination__link doc-pagination__link--next" rel="next">
          <span class="doc-pagination__dir">Next <svg class="as-icon" width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          <span class="doc-pagination__title">Components &rarr;</span>
        </a>
      </nav>
    </div>
  </article>
</DocsLayout>
